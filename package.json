{
  "name": "@knowledgeislands/mcp-claude-housekeeping",
  "description": "MCP for auditing and pruning Claude Code session files and memory on the local filesystem.",
  "version": "0.9.0",
  "author": "kris@kris.me.uk",
  "bin": {
    "mcp-claude-housekeeping": "dist/mcp-server/index.js"
  },
  "bugs": {
    "url": "https://github.com/knowledgeislands/mcp-claude-housekeeping/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "knip": "^6.32.0",
    "lint-staged": "^17.3.0",
    "mcporter": "^0.13.2",
    "rumdl": "^0.2.54",
    "syncpack": "^15.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/mcp-server/index.d.ts",
      "import": "./dist/mcp-server/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js"
    },
    "./claude-code": {
      "types": "./dist/main/claude-code/index.d.ts",
      "import": "./dist/main/claude-code/index.js"
    },
    "./claude-desktop": {
      "types": "./dist/main/claude-desktop/index.d.ts",
      "import": "./dist/main/claude-desktop/index.js"
    },
    "./vscode": {
      "types": "./dist/main/vscode/index.d.ts",
      "import": "./dist/main/vscode/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/knowledgeislands/mcp-claude-housekeeping#readme",
  "keywords": [
    "anthropic",
    "audit",
    "claude",
    "filesystem",
    "housekeeping",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "bunx @biomejs/biome check --write --no-errors-on-unmatched"
    ],
    "*.md": [
      "bunx rumdl check --fix"
    ]
  },
  "main": "dist/mcp-server/index.js",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowledgeislands/mcp-claude-housekeeping.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf {dist,node_modules}",
    "ki:deps:update": "bun update --latest",
    "ki:generate:client": "mcporter emit-ts kit-mcp-claude-housekeeping --mode client --out src/generated/client.ts --types-out src/generated/types.d.ts && printf '// @ts-nocheck\\n' | cat - src/generated/client.ts > /tmp/gen-tmp.ts && mv /tmp/gen-tmp.ts src/generated/client.ts",
    "ki:server:mcp:dev": "NODE_ENV=development bun --watch src/mcp-server/index.ts",
    "ki:server:mcp:inspect": "NODE_ENV=development bunx @modelcontextprotocol/inspector bun src/mcp-server/index.ts",
    "ki:server:mcp:start": "bun run build && node dist/mcp-server/index.js",
    "ki:test:smoke": "bun run build && bun scripts/smoke.ts",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "type": "module"
}
