# Absolute path or "~/..." to the directory where audit reports are written.
# The cleaner tools clear/save cowork-audit-YYYY-MM-DD.md files here.
HOUSEKEEPING_PATH=~/Documents/Claude/Projects/Claude Housekeeping

# Optional: comma-separated list of enabled roles. Allowed: auditor, cleaner.
# Defaults to "auditor" only when unset. Set to "auditor,cleaner" to also
# expose the destructive cleaner tools.
# HOUSEKEEPING_ROLES=auditor,cleaner
