# Absolute path or "~/..." to the directory where audit reports are written.
# Destructive-level tools clear/save cowork-audit-YYYY-MM-DD.md files here.
MCP_CLAUDE_HOUSEKEEPING_PATH=~/Documents/Claude/Projects/Claude Housekeeping

# Optional: maximum access level to register. One of: read, write, destructive.
# Defaults to `read` only when unset (least privilege). Raise to `destructive`
# to also expose the destructive tools (prune, relocate, delete). Each tool's
# level is derived from its MCP annotations (readOnlyHint / destructiveHint),
# not its name; see src/utils/access-level.ts.
# MCP_CLAUDE_HOUSEKEEPING_ACCESS_LEVEL=destructive
