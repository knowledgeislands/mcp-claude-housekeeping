{
  "name": "@knowledgeislands/mcp-claude-housekeeping",
  "description": "MCP for auditing and cleaning the Claude Cowork local-agent-mode-sessions filesystem",
  "version": "1.0.0",
  "author": "kris@kris.me.uk",
  "bin": {
    "mcp-claude-housekeeping": "dist/mcp-server/index.js"
  },
  "bugs": {
    "url": "https://github.com/knowledgeislands/mcp-claude-housekeeping/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^25.7.0",
    "@vitest/coverage-v8": "^4.1.6",
    "husky": "^9.1.7",
    "json5": "^2.2.3",
    "lint-staged": "^17.0.4",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.3",
    "syncpack": "^15.1.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/knowledgeislands/mcp-claude-housekeeping#readme",
  "keywords": [
    "anthropic",
    "audit",
    "claude",
    "filesystem",
    "housekeeping",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{ts,js,json,jsonc}": "npx @biomejs/biome check --write --no-errors-on-unmatched"
  },
  "main": "dist/mcp-server/index.js",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowledgeislands/mcp-claude-housekeeping.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf {dist,node_modules}",
    "dev:mcp": "NODE_ENV=development tsx watch src/mcp-server/index.ts",
    "format": "npx @biomejs/biome format --write",
    "inspect": "NODE_ENV=development npx @modelcontextprotocol/inspector tsx src/mcp-server/index.ts",
    "lint:check": "npx @biomejs/biome check",
    "lint:deps:missing": "npx depcheck --json | npx node-jq --sort-keys '.' | npx node-jq '.missing | keys | .[]' | xargs npm add -D",
    "lint:deps:unused": "npx depcheck --json | npx node-jq --sort-keys '.' | npx node-jq '.devDependencies[]' | xargs npm uninstall",
    "lint:fix": "npx @biomejs/biome check --write --unsafe",
    "lint:md": "npx prettier --write \"**/*.md\" --ignore-path .gitignore && npx markdownlint-cli2",
    "lint:package": "npx syncpack format",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "prestart:mcp": "npm run build",
    "start:mcp": "node dist/mcp-server/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "update:libs": "npx npm-check-updates"
  },
  "type": "module",
  "types": "dist/mcp-server/index.d.ts"
}
