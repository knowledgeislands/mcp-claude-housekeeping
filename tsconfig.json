{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Base",
  "compilerOptions": {
    "incremental": true,
    "composite": true,
    "target": "esnext",
    "lib": ["esnext"],
    "experimentalDecorators": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node", "vitest/globals"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "allowJs": true,
    // FIXME: would be good to enable checkJs
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,
    // NOTE: inlineSources false to reduce emitted size
    "inlineSources": false,
    "noEmitOnError": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    // FIXME: strictPropertyInitialization should be true
    "strictPropertyInitialization": false,
    // FIXME: noUnusedLocals should be true
    "noUnusedLocals": false,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "**/*.mjs", "commitlint.config.ts", "lint-staged.config.ts", "prettier.config.ts", "syncpack.config.ts", "vitest.config.ts"],
  "exclude": ["cdk.out", "node_modules", "dist"]
}
