# Local-agent-mode-sessions Audit Configuration

# Absolute path or "~/..." to the local-agent-mode-sessions inner directory
# (the one that contains local_*.json, artifacts.json, spaces/, rpm/, etc.).
# On macOS this is typically the second-level UUID directory under
# ~/Library/Application Support/Claude/local-agent-mode-sessions/.
ROOT_PATH=~/Library/Application Support/Claude/local-agent-mode-sessions/<account-uuid>/<workspace-uuid>

# Absolute path or "~/..." to the directory where audit reports are written.
# The cleaner tools clear/save cowork-audit-YYYY-MM-DD.md files here.
HOUSEKEEPING_PATH=~/Documents/Claude/Projects/Claude Housekeeping
